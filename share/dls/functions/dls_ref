emulate -L zsh

# usage: dls_ref <reference>
#
# Normalize a secret reference into REPLY as op://vault/item/field. The
# op:// prefix may be omitted. The field segment may itself contain a
# section, op://vault/item/section/field. Returns non-zero and sets REPLY
# to the empty string when the reference cannot be normalized.


typeset _dls_reference=${1:-}
[[ $_dls_reference = op://* ]] || _dls_reference=op://$_dls_reference
if [[ $_dls_reference != op://?*/?*/?* ]]; then
    REPLY=''
    return 1
fi
REPLY=$_dls_reference
