emulate -L zsh

# usage: dls_signout <account>
#
# End the 1Password CLI session so that the next `op read` requires a
# fresh biometric authorization. The caller invokes this once for each account
# contacted by a cold batch. Failure is a warning, not an error: the server
# keeps serving and the human decides what to do about a session that will not
# close.

typeset _dls_account=${1:-} _dls_out _dls_err
[[ -n $_dls_account ]] ||
    abend 'fatal: dls_signout called without an account'
pocket _dls_out _dls_err _dls_op signout --account $_dls_account ||
    print -r -u 2 -- \
        "dls: warning: op signout failed for $_dls_account; the op session may remain authorized"
