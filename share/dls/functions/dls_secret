# usage: dls_secret <variable> <reference>
#
# Resolve a secret reference to its value: from the server cache when
# warm, otherwise fetched by `op read` — one biometric authorization —
# and signed out immediately in the always block. The value is assigned
# to the named variable, which must be declared in the caller's scope.
# Sets REPLY to an error message on failure. Server side only, parent
# process only; see dls_fetch.

emulate -L zsh

[[ -n ${1:-} && -v ${1:-} ]] || {
    REPLY='dls_secret: return variable undefined'
    return 70
}
dls_ref ${2:-} || {
    REPLY="dls: invalid secret reference: ${2:-}"
    return 65
}
typeset _dls_reference=$REPLY

[[ -v _dls_cache ]] || {
    REPLY='dls_secret: no cache in scope: dls_secret is server side only'
    return 69
}

if (( ! ${+_dls_cache[$_dls_reference]} )); then
    {
        dls_fetch $_dls_reference || return
    } always {
        dls_signout
    }
fi

: ${(P)1::=${_dls_cache[$_dls_reference]}}
return 0
